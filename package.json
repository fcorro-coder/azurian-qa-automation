{
  "name": "azurian-qa-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --config cucumber.cjs",
    "test:api": "cucumber-js --config cucumber.cjs --tags @api",
    "test:ui": "cucumber-js --config cucumber.cjs --tags @ui",
    "typecheck": "tsc --noEmit",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test:check": "npm run typecheck && npm test",
    "report:archive": "node scripts/allure-archive.cjs",
    "report:clean": "node scripts/allure-clean.cjs",
    "test:hybrid": "cucumber-js --config cucumber.cjs --tags @hibrido",
    "report:verify": "node scripts/allure-verify.cjs",
    "report:environment": "node scripts/allure-environment.cjs",
    "test:official": "npm run typecheck && npm run report:archive && npm run report:clean && npm run report:environment && npm test && npm run report:verify && npm run report:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "dotenv": "^18.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
